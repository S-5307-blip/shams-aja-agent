{
  "name": "shamsaja-agents-platform",
  "version": "0.1.0",
  "private": true,
  "description": "منصة وكلاء شمس أجا: لوحة تحكم معزولة لتشغيل وكلاء الذكاء الاصطناعي لعملاء الشركات",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:env": "node --import tsx scripts/check-env.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "bootstrap:owner": "node --import tsx scripts/bootstrap-owner.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@prisma/client": "6.12.0",
    "jose": "6.2.12",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.28",
    "prisma": "6.12.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9 <25"
  }
}
