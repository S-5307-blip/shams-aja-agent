// منصة وكلاء شمس أجا — قاعدة بيانات مستقلة تمامًا عن موقع المكتب.
// كل سجل يخص عميلًا (منشأة) يحمل tenantId، وكل استعلام من الواجهة البرمجية يُقيَّد به.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// موظفو المنصة الذين يدخلون لوحة التحكم (ليسوا عملاء).
enum OperatorRole {
  owner
  admin
  viewer
}

enum TenantStatus {
  active
  suspended
}

enum AgentStatus {
  draft
  active
  paused
}

enum MessageRole {
  user
  assistant
}

enum UsageSource {
  api
  playground
}

enum UsageStatus {
  ok
  refused
  error
}

model Operator {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  role           OperatorRole @default(admin)
  passwordHash   String
  active         Boolean      @default(true)
  /// يُرفع عند تغيير كلمة المرور أو الإيقاف فتسقط كل الجلسات القديمة.
  sessionVersion Int          @default(1)
  failedLogins   Int          @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  auditLogs      AuditLog[]
}

/// عميل B2B: منشأة تشتري وكيلًا أو أكثر.
model Tenant {
  id                    String         @id @default(cuid())
  name                  String
  slug                  String         @unique
  contactName           String?
  contactEmail          String?
  notes                 String?
  status                TenantStatus   @default(active)
  /// سقف التكلفة الشهرية بالسنت الأمريكي؛ فارغ = بلا سقف.
  monthlyBudgetUsdCents Int?
  /// أقصى عدد طلبات في الدقيقة لكل المنشأة.
  rateLimitPerMinute    Int            @default(30)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  agents                Agent[]
  apiKeys               ApiKey[]
  conversations         Conversation[]
  usage                 UsageEvent[]
}

model Agent {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  model           String         @default("claude-opus-5-5")
  /// low | medium | high
  effort          String         @default("medium")
  systemPrompt    String
  knowledge       String         @default("")
  /// يشمل رموز التفكير والرد معًا.
  maxOutputTokens Int            @default(16000)
  status          AgentStatus    @default(draft)
  /// يزيد مع كل تعديل على التعليمات أو المعرفة.
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  apiKeys         ApiKey[]
  conversations   Conversation[]
  usage           UsageEvent[]

  @@index([tenantId])
}

/// مفاتيح الواجهة البرمجية. لا يُحفظ المفتاح نفسه، فقط بصمته (SHA-256) وبدايته للعرض.
model ApiKey {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// عند تحديده لا يستطيع المفتاح استدعاء غير هذا الوكيل.
  agentId    String?
  agent      Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String       @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  usage      UsageEvent[]

  @@index([tenantId])
}

model Conversation {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// معرّف المستخدم النهائي كما يرسله نظام العميل (اختياري).
  userRef      String?
  source       UsageSource  @default(api)
  messageCount Int          @default(0)
  /// يمنع ردّين متزامنين على نفس المحادثة.
  pendingSince DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  messages     Message[]
  usage        UsageEvent[]

  @@index([tenantId, agentId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int
  role           MessageRole
  /// كتل المحتوى كما أعادها النموذج، تُعاد إليه دون تعديل في الدورة التالية.
  content        Json
  /// النص المقروء للعرض.
  text           String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, seq])
}

model UsageEvent {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  conversationId   String?
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  source           UsageSource
  model            String
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  cacheReadTokens  Int           @default(0)
  cacheWriteTokens Int           @default(0)
  /// التكلفة التقديرية بالميكرو دولار (جزء من مليون).
  costMicroUsd     Int           @default(0)
  latencyMs        Int           @default(0)
  status           UsageStatus
  errorCode        String?
  createdAt        DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([agentId, createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}
