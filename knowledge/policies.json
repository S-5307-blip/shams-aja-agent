    },
    {
      "id": "policy-office-02",
      "scope": "office",
      "text": "عرض السعر يصل قبل بدء التنفيذ، ويبدأ التنفيذ بعد قبول العرض والدفع.",
      "source": {
        "name": "قواعد وكيل واتساب المعتمدة (knowledge.json)",
