      "checked_at": "2026-10-20",
      "approval": "approved"
    },
    {
      "id": "policy-office-05",
      "scope": "office",
      "text": "المستندات تُرفع عبر بوابة الموقع الآمنة (من حساب العميل)، لا عبر واتساب.",
