    },
    {
      "id": "policy-office-04",
      "scope": "office",
      "text": "لا نطلب من العميل كلمة المرور ولا رمز التحقق ولا بيانات البطاقة البنكية عبر الدردشة.",
      "source": {
        "name": "قواعد وكيل واتساب المعتمدة (knowledge.json)",
        "kind": "office"
