# قاعدة بيانات خاصة بالمنصة فقط — لا تستخدم قاعدة بيانات موقع المكتب.
DATABASE_URL=postgresql://agents:agents@127.0.0.1:5432/agents_dev
# 32 حرفًا عشوائيًا فأكثر: openssl rand -base64 48
AUTH_SECRET=
# مفتاح Claude من مساحة عمل (Workspace) مستقلة في Anthropic Console خاصة بوكلاء العملاء.
ANTHROPIC_API_KEY=
# الرابط العام للمنصة، يظهر في صفحة التوثيق.
APP_URL=http://localhost:3000
