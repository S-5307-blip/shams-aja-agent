# ===== Meta (WhatsApp Cloud API) =====
WA_VERIFY_TOKEN=اكتب-هنا-أي-نص-سري-تختاره
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v24.0

# ===== رقم المالك (أرقام فقط مع رمز الدولة، بدون + ) =====
# يجب أن يكون رقماً مختلفاً عن رقم واتساب بزنس الخاص بالمكتب
OWNER_PHONE=9665XXXXXXXX

# ===== Anthropic (Claude API) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ===== التخزين =====
# على Railway اربط Volume على /data
DB_PATH=/data/agent.db

# =====================================================================
# وكيل عمليات المكتب (src/ops) — لا يحتاج متغيرات Meta أعلاه إلا لقناة واتساب
# =====================================================================
OPS_PORT=3100
# قاعدة مستقلة عن قاعدة وكيل واتساب. على Railway: /data/ops.db
OPS_DB_PATH=./data/ops.db
OPS_TIMEZONE=Asia/Riyadh

# ===== النموذج =====
# anthropic = Claude عبر ANTHROPIC_API_KEY أعلاه | mock = محاكاة للتجربة دون مفتاح
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=16000
# default = عند رفض النموذج لأسباب السلامة يعيد الخادم الطلب على نموذج احتياطي | off
LLM_REFUSAL_FALLBACK=default
AGENT_MAX_STEPS=8
# عدد الأدوار السابقة من المحادثة التي يتذكرها الوكيل
AGENT_HISTORY_TURNS=8
TOOL_TIMEOUT_MS=15000

# ===== التذكيرات =====
# manual = تُجهز للإرسال اليدوي بعد الاعتماد | whatsapp = تُرسل بقالب معتمد عبر WA_ACCESS_TOKEN و WA_PHONE_NUMBER_ID
REMINDER_CHANNEL=manual
WA_TEMPLATE_LANG=ar
WA_RENEWAL_TEMPLATE=renewal_reminder
# اتركها فارغة حتى تعتمد Meta قوالب لهذه الأنواع
WA_MISSING_DOCS_TEMPLATE=
WA_FOLLOWUP_TEMPLATE=
STALE_TRANSACTION_DAYS=5
