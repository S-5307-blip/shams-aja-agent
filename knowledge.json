    "offHours": "أهلاً بك، هنا مساعد شمس أجا الآلي. استلمنا رسالتك خارج ساعات العمل، وسنرد عليك خلال ساعات العمل ({hours}).",
    "documentsGuidance": "لحماية بياناتك، نرجو رفع المستندات عبر بوابتنا الآمنة: {portal}. لا نستقبل صور الهويات هنا.",
    "optOutConfirmed": "تم إيقاف الرسائل التسويقية عنك. لن نرسل لك عروضاً بعد الآن، ويسعدنا خدمتك متى احتجت."
  },
  "policies": [
    "أتعاب المكتب منفصلة عن الرسوم الحكومية، والرسوم الحكومية تُدفع كما هي وتخضع للرسوم النافذة لدى الجهة المختصة وقت التنفيذ.",
    "عرض السعر يصل قبل بدء التنفيذ، ويبدأ التنفيذ بعد قبول العرض والدفع.",
    "وسيلة الدفع الحالية: تحويل بنكي بعد قبول عرض السعر، ويبدأ التنفيذ بعد تأكيد المكتب استلام التحويل.",
    "لا نطلب من العميل كلمة المرور ولا رمز التحقق ولا بيانات البطاقة البنكية عبر الدردشة.",
    "المستندات تُرفع عبر بوابة الموقع الآمنة (من حساب العميل)، لا عبر واتساب.",
    "لا نمنح خصومات عبر المساعد الآلي، والاستثناءات يقررها المالك."
  ],
  "faq": [
    {
      "q": "هل شمس أجا جهة حكومية؟",
      "a": "لا. شمس أجا مكتب خدمات عامة وتعقيب معاملات، وليس تابعاً لأي وزارة أو منصة رسمية. ننفذ المعاملات داخل القنوات الرسمية بصلاحية أو تفويض نظامي من العميل."
    },
    {
      "q": "هل تطلبون كلمة المرور أو رمز التحقق؟",
      "a": "أبداً. لا نطلب كلمات المرور ولا رموز التحقق، والتفويض يتم عبر القنوات النظامية فقط."
    },
    {
      "q": "هل تقدمون الخدمات لجميع مناطق المملكة؟",
      "a": "نستقبل الطلبات إلكترونياً من جميع مناطق المملكة. وقد تتطلب بعض المعاملات حضور العميل أو تفويضاً أو إجراءً لدى الجهة المختصة بحسب نوع الخدمة وحالة الطلب."
    },
    {
      "q": "ما المقصود بحالة الخدمة؟",
      "a": "«متاحة» تُنفذ مباشرة بعد التسعير. «تُراجع الأهلية» يتحقق الفريق من استيفاء الشروط قبل التسعير والتنفيذ. «عبر شريك مرخص» تُصدر عبر جهة مرخصة وتتحدد التكلفة حسب الشريك."
    }
  ],
